local function updateSpin(character)
    if not character then return end
    local humanRoot = character:FindFirstChild("HumanoidRootPart")
    if not humanRoot then return end
    
    for _, v in pairs(humanRoot:GetChildren()) do
        if v.Name == "Spinning" then
            v:Destroy()
        end
    end
    
    if _G.AutoSpin then
        local Spin = Instance.new("BodyAngularVelocity")
        Spin.Name = "Spinning"
        Spin.Parent = humanRoot
        Spin.MaxTorque = Vector3.new(0, math.huge, 0)
        Spin.AngularVelocity = Vector3.new(0, _G.SpinSpeed, 0)
    end
end

local player = game:GetService("Players").LocalPlayer
