    "JumpKick", "HandKick", "DoubleReg", "CraneKick", 
    "LegSweep", "RightPunch", "LeftPunch"
}

Heartbeat:Connect(function(deltaTime)
    if _G.AutoStr then
        acumuladorStr = acumuladorStr + deltaTime
        if acumuladorStr >= INTERVALO_TEMPO_HB then
            acumuladorStr = acumuladorStr - INTERVALO_TEMPO_HB
            pcall(function()
                local Remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                if Remotes then
                    for _, nomeGolpe in ipairs(golpes) do
                        local remote = Remotes:FindFirstChild(nomeGolpe)
                        if remote then
                            remote:FireServer()
                        end
                    end
                    local Dumbell = Remotes:FindFirstChild("Dumbell")
                    if Dumbell then
                        Dumbell:FireServer("Rep", 3)
                    end
                end
            end)
        end
    end
end)

